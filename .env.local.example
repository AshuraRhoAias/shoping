# ── Next.js Frontend ──────────────────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores

# URL interna del servidor Fastify (usada por las rutas Server Component)
# En Docker/producción cambia por el nombre del servicio: http://api:4000
FASTIFY_URL=http://localhost:4000

# URL pública del propio servidor Next.js (usada en Server Components para
# llamadas internas proxy → Next.js → Fastify)
NEXTJS_INTERNAL_URL=http://localhost:3000

# Origen permitido para el middleware CSRF (debe coincidir con la URL pública)
NEXTAUTH_URL=http://localhost:3000

# ── Base de datos (POS routes /api/pos/*) ─────────────────────────────────────
# Estas variables deben coincidir con las del servidor Fastify (server/.env)
DB_TYPE=mysql              # postgres | mysql
DB_HOST=127.0.0.1
DB_PORT=3306               # 5432 para postgres, 3306 para mysql
DB_NAME=shopdb
DB_USER=shopuser
DB_PASSWORD=

# ── Cifrado multi-capa (proxy /api/proxy/*) ───────────────────────────────────
# Deben coincidir exactamente con MASTER_SECRET y MASTER_SALT del servidor
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MASTER_SECRET=CHANGE_ME_64_BYTE_HEX_STRING
MASTER_SALT=CHANGE_ME_32_BYTE_HEX_STRING
