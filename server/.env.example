# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
BODY_LIMIT=5242880           # 5 MB in bytes
CLUSTER_WORKERS=             # Leave empty to auto-detect CPU count

# ── Encryption master keys ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
MASTER_SECRET=CHANGE_ME_64_BYTE_HEX_STRING_AT_LEAST_128_CHARS
MASTER_SALT=CHANGE_ME_32_BYTE_HEX_STRING

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_MIN_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_BRANCH_TTL=24h

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: allow any sub-domain (regex)
# CORS_DOMAIN_PATTERN=^https://.*\.yourdomain\.com$

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=2000          # requests per window per IP
RATE_LIMIT_WINDOW=1 minute
# Comma-separated IPs to exclude from rate limiting
RATE_LIMIT_ALLOWLIST=127.0.0.1,::1

# ── Base de datos ─────────────────────────────────────────────────────────────
# Estas variables son escritas automáticamente por el wizard al ejecutar:
#   node server/index.js  (primera vez)
# Si CREATE_WEB ya existe y coincide con el hash, el wizard se salta el setup.
# Puedes sobrescribirlas manualmente si cambias de base de datos.
DB_TYPE=postgres             # postgres | mysql
DB_HOST=127.0.0.1
DB_PORT=5432                 # 5432 para postgres, 3306 para mysql
DB_NAME=shopdb
DB_USER=shopuser
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=20
# Hash de verificación — generado por el wizard con HMAC-SHA256(type:host:port:name:user, MASTER_SECRET)
# Si está presente y coincide, el setup de DB se omite completamente.
CREATE_WEB=

# ── Business ──────────────────────────────────────────────────────────────────
TAX_RATE=0.16                # 16% default
