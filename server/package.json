{
  "name": "shop-fastify-server",
  "version": "1.0.0",
  "description": "High-performance Fastify API with multi-layer encryption, JWT, CORS and Docker DB auto-setup",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "setup": "node scripts/setup-db.js",
    "start": "node index.js",
    "dev":   "node --watch index.js",
    "start:single": "CLUSTER_WORKERS=1 node index.js"
  },
  "dependencies": {
    "@fastify/compress":  "^8.0.0",
    "@fastify/cors":      "^10.0.0",
    "@fastify/helmet":    "^13.0.0",
    "@fastify/jwt":       "^9.0.0",
    "@fastify/rate-limit":"^10.0.0",
    "fastify":            "^5.0.0",
    "fastify-plugin":     "^5.0.0",
    "dotenv":             "^16.4.7",
    "pino":               "^9.6.0",
    "pino-pretty":        "^13.0.0",
    "pg":                 "^8.13.0",
    "mysql2":             "^3.11.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
